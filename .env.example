# Путь API для браузера. Vite подставляет его при сборке.
VITE_API_BASE_URL=/api/v1

# Адрес Django для прокси локального сервера Vite.
API_PROXY_TARGET=http://127.0.0.1:8000

# Адрес Django для Nginx внутри Docker. Пример для сервиса backend в общей сети.
# Для Django на хосте Docker Desktop используйте http://host.docker.internal:8000
BACKEND_URL=http://backend:8000
