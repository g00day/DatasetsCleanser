# Локальный запуск Django в Docker. Скопируйте этот файл в .env рядом с Dockerfile.
DJANGO_PRODUCTION=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
FRONTEND_URL=http://localhost:8080

# Миграции, API и воркер используют один том, смонтированный в /var/lib/datasetcleanser.
SQLITE_PATH=/var/lib/datasetcleanser/db.sqlite3
PRIVATE_FILE_ROOT=/var/lib/datasetcleanser/files

# Пустое имя базы включает SQLite. Для PostgreSQL укажите параметры сервера.
DATABASE_NAME=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=

# При локальной разработке письмо восстановления выводится в журнал API.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
