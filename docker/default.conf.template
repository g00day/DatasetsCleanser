server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    location ^~ /api/v1/ {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $backend "${BACKEND_URL}";
        proxy_pass $backend;
        proxy_set_header Host $http_host;
        client_max_body_size 12m;
    }

    location /assets/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
