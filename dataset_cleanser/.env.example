# Local development defaults. Replace SECRET_KEY and enable production checks before deployment.
DJANGO_PRODUCTION=false
DJANGO_DEBUG=false
SECRET_KEY=replace-with-a-random-secret-before-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_COOKIES=false
DJANGO_TRUST_PROXY_HTTPS=false
DJANGO_CSRF_TRUSTED_ORIGINS=
API_CORS_ORIGINS=

# Leave DATABASE_NAME empty to use a local SQLite database.
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
SQLITE_PATH=

# Keep uploads outside the public static and media directories.
PRIVATE_FILE_ROOT=private_files
MAX_FILE_BYTES=10485760
MAX_OWNER_STORAGE_BYTES=536870912
MAX_ACTIVE_JOBS_PER_OWNER=4
JOB_TIMEOUT_SECONDS=600
JOB_LEASE_SECONDS=60

API_SESSION_IDLE_SECONDS=1800
API_SESSION_MAX_SECONDS=604800
API_RESET_TOKEN_SECONDS=1800

FRONTEND_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# For an offline development mailbox set EMAIL_BACKEND to
# django.core.mail.backends.console.EmailBackend.
